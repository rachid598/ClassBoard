#include <winver.h>

/* Icônes de l'application et des documents */

IDI_ICON1               ICON    DISCARDABLE     "ClassBoard.ico"
IDI_ICON2               ICON    DISCARDABLE     "OpenBoardDoc.ico"

/* Informations de version */

VS_VERSION_INFO VERSIONINFO

FILEVERSION    	UBVERSION_RC

PRODUCTVERSION 	UBVERSION_RC

FILEFLAGSMASK  	VS_FFI_FILEFLAGSMASK

#ifdef PRE_RELEASE
FILEFLAGS       VS_FF_PRERELEASE
#endif

FILEOS         	VOS__WINDOWS32

FILETYPE       	VFT_APP

BEGIN

    BLOCK "StringFileInfo"

    BEGIN

        BLOCK "040C04E4" /* Français, page de code 1252 */

        BEGIN

            VALUE "CompanyName",      "Contributeurs ClassBoard\000"

            VALUE "FileDescription",  "ClassBoard - tableau blanc interactif\000"

            VALUE "FileVersion",      UBVERSION

            VALUE "LegalCopyright",   "GPL-3.0. Base sur OpenBoard (c) Open Education Foundation\000"

            VALUE "OriginalFilename", "ClassBoard.exe\000"

            VALUE "ProductName",      "ClassBoard\000"

            VALUE "ProductVersion",   UBVERSION

        END

    END

    BLOCK "VarFileInfo"

    BEGIN

        VALUE "Translation", 0x040C, 1252

    END

END
